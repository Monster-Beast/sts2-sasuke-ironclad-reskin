<Project Sdk="Godot.NET.Sdk/4.5.1">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GodotDisabledSourceGenerators>GodotPluginsInitializer</GodotDisabledSourceGenerators>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../SasukeIroncladCode/Runtime/**/*.cs" Link="Runtime/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../SasukeIroncladCode/Adapters/**/*.cs" Link="Adapters/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../SasukeIroncladCode/Visuals/**/*.cs" Link="Visuals/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
