<Project Sdk="Godot.NET.Sdk/4.5.1" InitialTargets="CheckDependencyPaths">
  <Import Project=".\Sts2PathDiscovery.props"/>
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>true</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AppOutputBase>$(MSBuildProjectDirectory)\</AppOutputBase>
    <PathMap>$(AppOutputBase)=.\</PathMap>
    <GodotDisabledSourceGenerators>GodotPluginsInitializer</GodotDisabledSourceGenerators>
    <NoWarn>$(NoWarn);MSB3270</NoWarn>
    <ModOutputDirectory>$(ModsPath)$(MSBuildProjectName)/</ModOutputDirectory>
    <ModPckPath>$(ModOutputDirectory)$(MSBuildProjectName).pck</ModPckPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="SasukeIroncladCode/**/*.cs" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(Sts2DataDir)')">
    <Reference Include="0Harmony"><HintPath>$(Sts2DataDir)/0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="sts2"><HintPath>$(Sts2DataDir)/sts2.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(PublicizeSts)' == 'true'">
    <Publicize Include="sts2" IncludeVirtualMembers="false" IncludeCompilerGeneratedMembers="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- BaseLib is a runtime Mod dependency declared in SasukeIronclad.json.
         The production assembly does not consume BaseLib APIs directly, so a
         floating NuGet package must not raise the Mod loader minimum version. -->
    <PackageReference Include="Krafs.Publicizer" Version="2.3.0" PrivateAssets="All"/>
    <PackageReference Include="Alchyr.Sts2.ModAnalyzers" Version="*" />
    <AdditionalFiles Include="SasukeIronclad/localization/**/*.json"/>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Remove="SasukeIronclad/**" />
    <EmbeddedResource Remove="art/**" />
    <EmbeddedResource Remove="animation/**" />
  </ItemGroup>

  <ItemGroup>
    <None Condition="Exists('Directory.Build.props')" Include="Directory.Build.props"/>
    <None Include=".gitignore" />
    <None Include="SasukeIronclad.json" />
    <None Include="project.godot"/>
    <None Include="SasukeIronclad/**" />
  </ItemGroup>

  <Target Name="CheckDependencyPaths">
    <Error Text="Slay the Spire 2 data not found at path '$(Sts2DataDir)'" Condition="'$(Sts2DataDir)' == '' or !Exists('$(Sts2DataDir)')" />
  </Target>

  <Target Name="GenerateModManifest" BeforeTargets="BeforeBuild">
    <PropertyGroup>
      <SourceManifestPath>$(MSBuildProjectDirectory)\$(MSBuildProjectName).json</SourceManifestPath>
      <GeneratedManifestDirectory>$(IntermediateOutputPath)generated\</GeneratedManifestDirectory>
      <GeneratedManifestPath>$(GeneratedManifestDirectory)$(MSBuildProjectName).json</GeneratedManifestPath>
    </PropertyGroup>
    <MakeDir Directories="$(GeneratedManifestDirectory)" />
    <Copy SourceFiles="$(SourceManifestPath)" DestinationFiles="$(GeneratedManifestPath)" />
  </Target>

  <Target Name="CopyToModsFolderOnBuild" AfterTargets="PostBuildEvent" DependsOnTargets="GenerateModManifest">
    <MakeDir Directories="$(ModOutputDirectory)" />
    <Error Text="Generated Mod manifest was not created at '$(GeneratedManifestPath)'." Condition="!Exists('$(GeneratedManifestPath)')" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModOutputDirectory)" />
    <Copy SourceFiles="$(GeneratedManifestPath)" DestinationFolder="$(ModOutputDirectory)" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(ModOutputDirectory)" />
  </Target>

  <Target Name="NeedGodotForPublish" BeforeTargets="Publish">
    <Error Text="Godot path must be configured; not found at '$(GodotPath)'." Condition="'$(GodotPath)' == '' or !Exists('$(GodotPath)')"/>
  </Target>

  <Target Name="GodotPublish" AfterTargets="Publish" Condition="'$(GodotPath)' != '' and Exists('$(GodotPath)') and '$(IsInnerGodotExport)' != 'true'">
    <MakeDir Directories="$(ModOutputDirectory)" />
    <Delete Files="$(ModPckPath)" />
    <Exec
      Command="&quot;$(GodotPath)&quot; --headless --path &quot;$(MSBuildProjectDirectory)&quot; --export-pack &quot;BasicExport&quot; &quot;$(ModPckPath)&quot;"
      WorkingDirectory="$(MSBuildProjectDirectory)"
      EnvironmentVariables="IsInnerGodotExport=true;MSBUILDDISABLENODEREUSE=1"
      IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="GodotExportExitCode" />
    </Exec>
    <Error Text="Godot did not produce the expected PCK at '$(ModPckPath)' (exit code $(GodotExportExitCode))." Condition="!Exists('$(ModPckPath)')" />
    <Warning Text="Godot returned exit code $(GodotExportExitCode) after producing a new PCK. The pack will be validated by the real-game observation run." Condition="'$(GodotExportExitCode)' != '0' and Exists('$(ModPckPath)')" />
  </Target>
</Project>
